        default="$(find-pkg-share dummy_pointcloud_publisher)/config/topic_info.param.yaml" />

  <node pkg="dummy_pointcloud_publisher" exec="dummy_pointcloud_publisher_node" name="dummy_pointcloud_publisher" output="screen"
      args="
